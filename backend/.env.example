# Copia este archivo a .env y edítalo.

# Obligatorio. Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(24))"
DASH_TOKEN=

# Zona horaria IANA en la que se calcula "hoy" y las horas de la agenda
DASH_TZ=America/Santiago

# Ubicación del clima
DASH_LAT=-33.45
DASH_LON=-70.66
DASH_LOCATION_NAME=Santiago

# URLs .ics secretas de tus calendarios, separadas por coma (¡no las compartas!)
DASH_ICS_URLS=

DASH_WEATHER_REFRESH_S=900
DASH_CALENDAR_REFRESH_S=300
DASH_MAX_EVENTS=8

# Puerto publicado en el host
DASH_PORT=8080
